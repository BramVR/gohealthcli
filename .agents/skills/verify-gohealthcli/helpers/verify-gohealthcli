  done < <(find "$backup_repo/data" -type f -name '*.age' -print)
  [[ "$shard_count" == 9 ]] || fail "backup data tree contains $shard_count encrypted shards, want 9"
  if find "$backup_repo/data" -type f ! -name '*.age' -print -quit | grep -q .; then
    fail 'backup data tree contains a non-age payload'
  fi

  local backup_branch
  backup_branch=$(task_git -C "$backup_repo" symbolic-ref --short HEAD)
  task_git -C "$backup_repo" rev-parse HEAD > "$evidence_root/backup-local-head-before-repeat.txt"
  task_git --git-dir="$backup_remote" rev-parse "refs/heads/$backup_branch" > "$evidence_root/backup-remote-head-before-repeat.txt"
  task_git -C "$backup_repo" status --porcelain=v1 > "$evidence_root/backup-git-status-before-repeat.txt"
  [[ ! -s "$evidence_root/backup-git-status-before-repeat.txt" ]] || fail 'backup checkout was dirty before the repeated push'
  cmp -s "$evidence_root/backup-local-head-before-repeat.txt" "$evidence_root/backup-remote-head-before-repeat.txt" || fail 'initial encrypted backup commit did not reach the task-owned remote'

  run_pty backup-push-repeat "$binary" backup push --config "$backup_config" --db "$archive_path" --json
  grep -Fq '"changed": false' "$evidence_root/backup-push-repeat.typescript" || fail 'unchanged backup push was not idempotent'
  task_git -C "$backup_repo" rev-parse HEAD > "$evidence_root/backup-local-head-after-repeat.txt"
  task_git --git-dir="$backup_remote" rev-parse "refs/heads/$backup_branch" > "$evidence_root/backup-remote-head-after-repeat.txt"
  task_git -C "$backup_repo" status --porcelain=v1 > "$evidence_root/backup-git-status-after-repeat.txt"
  cmp -s "$evidence_root/backup-local-head-before-repeat.txt" "$evidence_root/backup-local-head-after-repeat.txt" || fail 'repeated backup push changed local HEAD'
  cmp -s "$evidence_root/backup-remote-head-before-repeat.txt" "$evidence_root/backup-remote-head-after-repeat.txt" || fail 'repeated backup push changed the remote ref'
  cmp -s "$evidence_root/backup-local-head-after-repeat.txt" "$evidence_root/backup-remote-head-after-repeat.txt" || fail 'local and remote backup refs differ after the repeated push'
  cmp -s "$evidence_root/backup-git-status-before-repeat.txt" "$evidence_root/backup-git-status-after-repeat.txt" || fail 'repeated backup push changed checkout status'

  local recovery_readme_hash manifest_hash
  recovery_readme_hash=$(sha256_file "$backup_repo/README.md")
  manifest_hash=$(sha256_file "$backup_repo/manifest.json")
  verify_backup_history "$backup_repo" "$recovery_readme_hash" "$manifest_hash"
  verify_backup_history "$backup_remote" "$recovery_readme_hash" "$manifest_hash"
  printf 'local_and_remote_reachable_history: ciphertext-and-metadata allowlist passed\n' > "$evidence_root/backup-history-proof.txt"

  run_pty backup-status "$binary" backup status --config "$backup_config" --json
  grep -Fq '"encrypted": true' "$evidence_root/backup-status.typescript" || fail 'backup status did not report encrypted data'

  run_pty backup-pull "$binary" backup pull --config "$backup_config" --db "$restored_archive" --json
  grep -Fq '"status": "backup_pulled"' "$evidence_root/backup-pull.typescript" || fail 'backup pull did not complete'
  [[ -f "$restored_archive" && ! -L "$restored_archive" ]] || fail 'backup pull did not create a regular restored archive'
  run_pty backup-restored-status "$binary" --db "$restored_archive" --json status
  grep -Fq '"data_point_count": 0' "$evidence_root/backup-restored-status.typescript" || fail 'restored empty archive status drifted'
  run_pty backup-restored-counts "$binary" --db "$restored_archive" --json query "$snapshot_counts_query"
  grep -Fq "\"$expected_snapshot_counts\"" "$evidence_root/backup-restored-counts.typescript" || fail 'restored Snapshot table counts differ from the exact source counts'
  run_pty backup-restored-sentinel "$binary" --db "$restored_archive" --json query "$sentinel_query"
  grep -Fq '"row_count": 1' "$evidence_root/backup-restored-sentinel.typescript" || fail 'restored archive did not contain exactly one synthetic Connection'
  restored_sentinel_hex=$(tr -d '\r' < "$evidence_root/backup-restored-sentinel.typescript" | awk '/^[[:space:]]*"[0-9A-F]+",?[[:space:]]*$/ {gsub(/[ ",]/, ""); print; exit}')
  [[ "$restored_sentinel_hex" == "$expected_sentinel_hex" ]] || fail 'restored archive changed one or more synthetic Connection fields'
  [[ "$restored_sentinel_hex" == "$source_sentinel_hex" ]] || fail 'restored Connection fingerprint differs from the source archive'
  printf '%s\n' "$restored_sentinel_hex" > "$evidence_root/backup-restored-sentinel.hex"
  [[ ! -e "$credential_probe" ]] || fail 'local backup route attempted Credential Store access'

  printf 'route: backup\nresult: passed\nentries: synthetic-source-counts,synthetic-source-sentinel,local-remote,init,status-empty,push,idempotent-push,history-audit,status,pull,restored-status,restored-counts,restored-sentinel\nremote: task-owned bare Git repository\nencrypted_shards: %s tracked age ciphertext files\nprovider_access: none\ncredential_store_read: none\nrestore_consumption: all eight SQLite Snapshot table counts, the Attachment payload shard row count, and every synthetic Connection field restored exactly\nrestored_archive: verified through compiled CLI\n' "$shard_count" > "$evidence_root/backup-proof.txt"
}

drive() {
  [[ -n "$route" ]] || usage
  case "$route" in
    initialize|local|inspect|plan|sync|backup|connected|discover|catalog) ;;
    *) usage ;;
  esac
  local attempt_marker="$evidence_root/$route-attempted.txt"
  path_is_absent "$attempt_marker" && path_is_absent "$evidence_root/$route-proof.txt" || fail "route already attempted in this run: $route"
  (set -o noclobber; printf 'route: %s\nstarted_at: %s\n' "$route" "$(utc_now)" > "$attempt_marker") || fail "could not claim route attempt: $route"
  doctor_snapshot "before-$route"
  append_event route "$route" started null
  case "$route" in
    initialize) drive_initialize ;;
    local) drive_local ;;
    inspect) drive_inspect ;;
    plan) drive_plan ;;
    sync) drive_sync ;;
    backup) drive_backup ;;
    connected) drive_connected ;;
    discover) drive_discover ;;
    catalog) drive_catalog ;;
  esac
  printf '%s\n' "$route" >> "$evidence_root/routes.txt"
  doctor_snapshot "after-$route"
  append_event route "$route" passed 0
  write_manifest driven passed
}

cleanup() {
  require_evidence_root
  require_owned_run
  [[ "$run_root" == "/tmp/gohealthcli-verify-$run_id" ]] || fail 'refusing unexpected cleanup path'
  [[ -f "$evidence_root/git-status-before.txt" && ! -L "$evidence_root/git-status-before.txt" ]] || fail 'pre-run Git status evidence missing or unsafe'
  [[ -f "$evidence_root/repo-fingerprint-before.txt" && ! -L "$evidence_root/repo-fingerprint-before.txt" ]] || fail 'pre-run repository fingerprint missing or unsafe'
  repo_git -C "$repo_root" status --porcelain=v1 > "$evidence_root/git-status-after.txt"
  repo_content_fingerprint > "$evidence_root/repo-fingerprint-after.txt"
  local cleanup_target binary_hash
  cleanup_target=$run_root
  binary_hash=unavailable
  if [[ -f "$binary" && ! -L "$binary" ]]; then
    binary_hash=$(sha256_file "$binary")
  fi
  require_owned_run
  [[ "$run_root" == "/tmp/gohealthcli-verify-$run_id" ]] || fail 'refusing changed cleanup path'
  rm -rf -- "$run_root"
  path_is_absent "$run_root" || fail 'scratch cleanup failed'
  [[ -d "$evidence_root" ]] || fail 'cleanup removed evidence'
  if ! cmp -s "$evidence_root/repo-fingerprint-before.txt" "$evidence_root/repo-fingerprint-after.txt"; then
    append_event lifecycle cleanup failed 1
    write_manifest cleaned failed
    fail 'repository contents changed during verification; compare repository state with the recorded fingerprints'
  fi
  if ! cmp -s "$evidence_root/git-status-before.txt" "$evidence_root/git-status-after.txt"; then
    diff -u "$evidence_root/git-status-before.txt" "$evidence_root/git-status-after.txt" > "$evidence_root/git-status.diff" || true
    append_event lifecycle cleanup failed 1
    write_manifest cleaned failed
    fail 'repository Git status changed during verification; see git-status.diff'
  fi
  printf 'cleanup: passed\nrun_id: %s\ntarget: %s\nowner_marker: exact\nmethod: exact task-owned run root removed after ownership and symlink checks\nbinary_sha256_before: %s\nscratch_after: absent\nevidence_after: present\nrepo_fingerprint_before: repo-fingerprint-before.txt\nrepo_fingerprint_after: repo-fingerprint-after.txt\ngit_status_before: git-status-before.txt\ngit_status_after: git-status-after.txt\n' \
    "$run_id" "$cleanup_target" "$binary_hash" > "$evidence_root/cleanup.txt"
  append_event lifecycle cleanup passed 0
  write_manifest cleaned passed
  printf 'cleanup passed: %s\nevidence: %s\n' "$run_id" "$evidence_root"
}

manual_doctor() {
  local index=1 phase
  while :; do
    phase="manual-$index"
    if path_is_absent "$evidence_root/doctor-$phase.txt"; then
      doctor_snapshot "$phase"
      return
    fi
    index=$((index + 1))
  done
}

self_check() {
  [[ $# -eq 1 ]] || usage
  require_tools
  local schema_tmp expected_tmp actual_tmp self_root self_binary feature_file section_count feature_name command
  schema_tmp=$(mktemp /tmp/gohealthcli-verify-schema.XXXXXX)
  expected_tmp=$(mktemp /tmp/gohealthcli-verify-expected.XXXXXX)
  actual_tmp=$(mktemp /tmp/gohealthcli-verify-actual.XXXXXX)
  self_root=$(mktemp -d /tmp/gohealthcli-verify-self-check.XXXXXX)
  chmod 700 "$self_root"
  self_binary="$self_root/gohealthcli"
  trap 'rm -f "$schema_tmp" "$expected_tmp" "$actual_tmp"; rm -rf -- "$self_root"' EXIT

  bash -n "$helper_dir/verify-gohealthcli"
  [[ -x "$helper_dir/verify-gohealthcli" ]] || fail 'helper is not executable'

  local -a expected_commands=(
    init doctor catalog connect identity profile settings devices irn-profile sync
    backup status query export raw describe-schema completion schema docs-export-datasets
  )
  printf '%s\n' "${expected_commands[@]}" | sort > "$expected_tmp"
  isolated_go_build "$self_root/build-state" "$self_binary"
  "$self_binary" schema --json > "$schema_tmp"
  sed -n 's/^      "name": "\([^"]*\)",/\1/p' "$schema_tmp" | sort > "$actual_tmp"
  diff -u "$expected_tmp" "$actual_tmp" >/dev/null || fail 'Command Registry coverage changed; update the verification feature map and self-check list'

  for command in "${expected_commands[@]}"; do
    grep -Fq "\`$command\`" "$helper_dir/../features/README.md" || fail "feature index does not map Command Registry entry: $command"
  done
  for feature_file in "$helper_dir"/../features/*.md; do
    [[ "$(basename "$feature_file")" != README.md ]] || continue
    section_count=$(grep -c '^## ' "$feature_file")
    [[ "$section_count" == 4 ]] || fail "feature file must contain exactly four H2 sections: $feature_file"
    feature_name=$(basename "$feature_file")
    grep -Fq "($feature_name)" "$helper_dir/../features/README.md" || fail "feature file is not indexed: $feature_name"
  done

  rm -f "$schema_tmp" "$expected_tmp" "$actual_tmp"
  rm -rf -- "$self_root"
  trap - EXIT
  printf 'self-check: passed\n'
}

suite_cleanup() {
  local child owner
  for child in ${suite_owned_runs:-}; do
    owner="/tmp/gohealthcli-verify-$child/.gohealthcli-verify-owner"
    if [[ -f "$owner" && ! -L "$owner" && "$(<"$owner")" == "$child" ]]; then
      "$helper_dir/verify-gohealthcli" cleanup "$child" >/dev/null || true
    fi
  done
}

suite() {
  [[ -z "$route" || "$route" == smoke ]] || usage
  local suite_kind=${route:-smoke}
  [[ "$suite_kind" == smoke ]] || usage
  require_evidence_parent
  path_is_absent "$evidence_root" || fail "refusing existing suite evidence root: $evidence_root"
  local state_run="$run_id-state"
  local plan_run="$run_id-plan"
  local discover_run="$run_id-discover"
  local catalog_run="$run_id-catalog"
  local connected_run="$run_id-connected"
  local child
  for child in "$state_run" "$plan_run" "$discover_run" "$catalog_run" "$connected_run"; do
    path_is_absent "/tmp/gohealthcli-verify-$child" || fail "refusing existing child run root: /tmp/gohealthcli-verify-$child"
    path_is_absent "$evidence_parent/$child" || fail "refusing existing child evidence root: $evidence_parent/$child"
  done

  self_check self-check
  mkdir -m 700 "$evidence_root"
  printf '{"timestamp":"%s","event":"suite","label":"smoke","result":"started","exit_code":null}\n' "$(utc_now)" > "$evidence_root/events.jsonl"

  suite_owned_runs=''
  trap suite_cleanup EXIT

  suite_owned_runs=$state_run
  "$helper_dir/verify-gohealthcli" launch "$state_run"
  "$helper_dir/verify-gohealthcli" drive "$state_run" initialize
  "$helper_dir/verify-gohealthcli" drive "$state_run" local
  "$helper_dir/verify-gohealthcli" drive "$state_run" inspect
  "$helper_dir/verify-gohealthcli" drive "$state_run" sync
  "$helper_dir/verify-gohealthcli" drive "$state_run" backup
  "$helper_dir/verify-gohealthcli" cleanup "$state_run"

  local child_route
  for child_route in plan discover catalog connected; do
    case "$child_route" in
      plan) child=$plan_run ;;
      discover) child=$discover_run ;;
      catalog) child=$catalog_run ;;
      connected) child=$connected_run ;;
    esac
    suite_owned_runs+=" $child"
    "$helper_dir/verify-gohealthcli" launch "$child"
    "$helper_dir/verify-gohealthcli" drive "$child" "$child_route"
    "$helper_dir/verify-gohealthcli" cleanup "$child"
  done

  {
    printf '{\n'
    printf '  "evidence_schema": 1,\n'
    printf '  "suite": "smoke",\n'
    printf '  "run_prefix": "%s",\n' "$run_id"
    printf '  "result": "passed",\n'
    printf '  "runs": ["%s","%s","%s","%s","%s"]\n' "$state_run" "$plan_run" "$discover_run" "$catalog_run" "$connected_run"
    printf '}\n'
  } > "$evidence_root/summary.json"
  printf '{"timestamp":"%s","event":"suite","label":"smoke","result":"passed","exit_code":0}\n' "$(utc_now)" >> "$evidence_root/events.jsonl"
  trap - EXIT
  printf 'suite passed: %s\nevidence: %s\n' "$run_id" "$evidence_root"
}

case "$action" in
  self-check) self_check "$@" ;;
  suite) [[ $# -le 3 ]] || usage; suite ;;
  launch) [[ $# -eq 2 ]] || usage; launch ;;
  doctor) [[ $# -eq 2 ]] || usage; manual_doctor ;;
  drive) [[ $# -eq 3 ]] || usage; drive ;;
  cleanup) [[ $# -eq 2 ]] || usage; cleanup ;;
  *) usage ;;
esac
