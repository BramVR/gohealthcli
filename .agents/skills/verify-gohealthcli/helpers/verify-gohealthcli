#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'verify-gohealthcli: %s\n' "$*" >&2
  exit 1
}

usage() {
  printf 'usage:\n' >&2
  printf '  verify-gohealthcli self-check\n' >&2
  printf '  verify-gohealthcli suite <run-prefix> [smoke]\n' >&2
  printf '  verify-gohealthcli <launch|doctor|cleanup> <run-id>\n' >&2
  printf '  verify-gohealthcli drive <run-id> <initialize|local|inspect|plan|sync|backup|connected|discover|catalog>\n' >&2
  exit 2
}

[[ $# -ge 1 ]] || usage
action=$1
run_id=${2:-}
route=${3:-}

if [[ "$action" != self-check ]]; then
  [[ -n "$run_id" ]] || usage
  [[ "$run_id" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || fail 'run-id must match [a-z0-9][a-z0-9._-]*'
fi

helper_dir=$(CDPATH= cd -- "$(dirname -- "$0")" >/dev/null && pwd -P)
repo_root=$(cd "$helper_dir/../../../.." && pwd -P)
run_root="/tmp/gohealthcli-verify-$run_id"
source_snapshot="$run_root/source"
evidence_parent="/tmp/gohealthcli-verify-evidence"
evidence_root="$evidence_parent/$run_id"
owner_file="$run_root/.gohealthcli-verify-owner"
binary="$run_root/bin/gohealthcli"
oauth_file="$run_root/synthetic-oauth-client.json"
config_path="$run_root/config/config.toml"
archive_path="$run_root/data/gohealthcli.sqlite"
sidecar_path="$archive_path.attachments"
home_path="$run_root/home"
default_config_path="$home_path/.config/gohealthcli/config.toml"
default_archive_path="$home_path/.local/share/gohealthcli/gohealthcli.sqlite"
default_sidecar_path="$default_archive_path.attachments"
discovery_file="$run_root/google-health-discovery-v4.json"
discovery_source="$repo_root/internal/googlehealth/testdata/google-health-discovery-v4.json"
readme_file="$run_root/README.md"
gitconfig_file="$home_path/.gitconfig"
shim_path="$run_root/shims"
credential_probe="$run_root/credential-store-accessed"
backup_root="$run_root/backup"
backup_config="$backup_root/backup.json"
backup_repo="$backup_root/checkout"
backup_remote="$backup_root/remote.git"
backup_identity="$backup_root/age-identity.txt"
restored_archive="$backup_root/restored.sqlite"
synthetic_oauth_json='{"installed":{"client_id":"synthetic-verification-client","client_secret":"synthetic-verification-secret","redirect_uris":["http://localhost"]}}'
go_executable=${GOHEALTHCLI_VERIFY_GO:-$(command -v go || true)}
export GOHEALTHCLI_VERIFY_GO="$go_executable"
system_path='/usr/bin:/bin:/usr/sbin:/sbin'
PATH=$system_path
export PATH
git_env_prefix=(
  /usr/bin/env
  -u GIT_DIR
  -u GIT_WORK_TREE
  -u GIT_COMMON_DIR
  -u GIT_INDEX_FILE
  -u GIT_OBJECT_DIRECTORY
  -u GIT_ALTERNATE_OBJECT_DIRECTORIES
  -u GIT_CONFIG
  -u GIT_CONFIG_COUNT
  -u GIT_CONFIG_PARAMETERS
  -u GIT_CONFIG_GLOBAL
  -u GIT_CONFIG_SYSTEM
  -u GIT_EXEC_PATH
  -u GIT_TEMPLATE_DIR
  -u GIT_CEILING_DIRECTORIES
  -u GIT_DISCOVERY_ACROSS_FILESYSTEM
  -u GIT_SSH
  -u GIT_SSH_COMMAND
  -u GIT_PROXY_COMMAND
  "PATH=$system_path"
)
task_env_prefix=(
  "${git_env_prefix[@]}"
  "HOME=$home_path"
  "XDG_CONFIG_HOME=$home_path/.config"
  "XDG_DATA_HOME=$home_path/.local/share"
  "PATH=$shim_path:$system_path"
  "GIT_CONFIG_NOSYSTEM=1"
  "GIT_ATTR_NOSYSTEM=1"
  "GIT_CONFIG_GLOBAL=$gitconfig_file"
  "GIT_TERMINAL_PROMPT=0"
  "HTTP_PROXY=http://127.0.0.1:1"
  "HTTPS_PROXY=http://127.0.0.1:1"
  "ALL_PROXY=http://127.0.0.1:1"
  "NO_PROXY="
  "http_proxy=http://127.0.0.1:1"
  "https_proxy=http://127.0.0.1:1"
  "all_proxy=http://127.0.0.1:1"
  "no_proxy="
)
pty_env_prefix=(
  /usr/bin/env
  -i
  "HOME=$home_path"
  "PATH=$system_path"
  "SHELL=/bin/sh"
  "TERM=dumb"
  "LC_ALL=C"
  "LANG=C"
)

repo_git() {
  "${git_env_prefix[@]}" GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null git "$@"
}

task_git() {
  "${task_env_prefix[@]}" git "$@"
}

isolated_go_build() {
  local build_root=$1 output=$2 ldflags=${3:-} target=${4:-./cmd/gohealthcli} build_source=${5:-$repo_root}
  local go_bin ambient_module_cache
  go_bin=$go_executable
  [[ "$go_bin" == /* && -x "$go_bin" ]] || fail 'go must resolve to an absolute executable path'
  ambient_module_cache=$(/usr/bin/env -u GOMODCACHE -u GOFLAGS -u GOWORK GOENV=off "$go_bin" env GOMODCACHE)
  [[ "$ambient_module_cache" == /* && -d "$ambient_module_cache/cache/download" ]] || fail 'local Go module download cache is unavailable'
  path_is_absent "$build_root" || fail "isolated Go build root already exists: $build_root"
  mkdir -m 700 "$build_root"
  mkdir "$build_root/home" "$build_root/cache" "$build_root/modcache" "$build_root/gopath" "$build_root/tmp"
  chmod 700 "$build_root/home" "$build_root/cache" "$build_root/modcache" "$build_root/gopath" "$build_root/tmp"
  local -a build_command
  build_command=("$go_bin" build -mod=readonly -modcacherw)
  if [[ -n "$ldflags" ]]; then
    build_command+=(-ldflags "$ldflags")
  fi
  build_command+=(-o "$output" "$target")
  (
    cd "$build_source"
    /usr/bin/env -i \
      "HOME=$build_root/home" \
      "PATH=$system_path" \
      "TMPDIR=$build_root/tmp" \
      "GOCACHE=$build_root/cache" \
      "GOMODCACHE=$build_root/modcache" \
      "GOPATH=$build_root/gopath" \
      "GOENV=off" \
      "GOFLAGS=" \
      "GOWORK=off" \
      "GOTOOLCHAIN=local" \
      "GOPROXY=file://$ambient_module_cache/cache/download" \
      "GOSUMDB=off" \
      "GOVCS=off" \
      "LC_ALL=C" \
      "LANG=C" \
      "${build_command[@]}"
  )
}

stage_source_snapshot() {
  path_is_absent "$source_snapshot" || fail 'source snapshot already exists'
  mkdir -m 700 "$source_snapshot"
  local relative source destination
  while IFS= read -r -d '' relative; do
    source="$repo_root/$relative"
    destination="$source_snapshot/$relative"
    [[ -f "$source" && ! -L "$source" ]] || fail "source snapshot input is not a regular file: $relative"
    mkdir -p "$(dirname "$destination")"
    cp -p "$source" "$destination"
  done < <(repo_git -C "$repo_root" ls-files --cached --others --exclude-standard -z)
  [[ -f "$source_snapshot/go.mod" && -f "$source_snapshot/cmd/gohealthcli/main.go" ]] || fail 'source snapshot is incomplete'
}

require_tools() {
  [[ "$go_executable" == /* && -x "$go_executable" ]] || fail 'go is required'
  command -v git >/dev/null || fail 'git is required'
  [[ -x /usr/bin/script ]] || fail '/usr/bin/script is required'
  case "$(uname -s)" in
    Darwin|Linux) ;;
    *) fail 'verification helper supports macOS and Linux only' ;;
  esac
  local pty_probe pty_rc=0
  pty_probe=$(mktemp /tmp/gohealthcli-verify-pty-exit.XXXXXX)
  set +e
  if [[ "$(uname -s)" == Darwin ]]; then
    "${pty_env_prefix[@]}" /usr/bin/script -q "$pty_probe" /bin/sh -c 'exit 7' >/dev/null 2>&1
    pty_rc=$?
  else
    "${pty_env_prefix[@]}" /usr/bin/script -q -e -c 'exit 7' "$pty_probe" >/dev/null 2>&1
    pty_rc=$?
  fi
  set -e
  rm -f "$pty_probe"
  [[ "$pty_rc" == 7 ]] || fail '/usr/bin/script does not propagate child exit status on this host'
}

mode_of() {
  if [[ "$(uname -s)" == Darwin ]]; then
    stat -f '%Lp' "$1"
  else
    stat -c '%a' "$1"
  fi
}

uid_of() {
  if [[ "$(uname -s)" == Darwin ]]; then
    stat -f '%u' "$1"
  else
    stat -c '%u' "$1"
  fi
}

require_evidence_parent() {
  if [[ ! -e "$evidence_parent" && ! -L "$evidence_parent" ]]; then
    mkdir -m 700 "$evidence_parent" 2>/dev/null || true
  fi
  [[ -d "$evidence_parent" && ! -L "$evidence_parent" ]] || fail "evidence parent is missing or unsafe: $evidence_parent"
  [[ "$(uid_of "$evidence_parent")" == "$(id -u)" ]] || fail 'evidence parent is not owned by the current user'
  if [[ "$(mode_of "$evidence_parent")" != 700 ]]; then
    chmod 700 "$evidence_parent"
  fi
  [[ "$(mode_of "$evidence_parent")" == 700 ]] || fail 'evidence parent must be mode 700'
}

require_evidence_root() {
  require_evidence_parent
  [[ -d "$evidence_root" && ! -L "$evidence_root" ]] || fail "evidence directory is missing or unsafe: $evidence_root"
  [[ "$(uid_of "$evidence_root")" == "$(id -u)" ]] || fail 'evidence directory is not owned by the current user'
  if [[ "$(mode_of "$evidence_root")" != 700 ]]; then
    chmod 700 "$evidence_root"
  fi
  [[ "$(mode_of "$evidence_root")" == 700 ]] || fail 'evidence directory must be mode 700'
}

sha256_file() {
  if command -v shasum >/dev/null; then
    shasum -a 256 "$1" | awk '{print $1}'
  elif command -v sha256sum >/dev/null; then
    sha256sum "$1" | awk '{print $1}'
  else
    fail 'shasum or sha256sum is required'
  fi
}

sha256_stream() {
  if command -v shasum >/dev/null; then
    shasum -a 256 | awk '{print $1}'
  elif command -v sha256sum >/dev/null; then
    sha256sum | awk '{print $1}'
  else
    fail 'shasum or sha256sum is required'
  fi
}

repo_content_fingerprint() {
  local entry path
  {
    printf 'head\0'
    repo_git -C "$repo_root" rev-parse HEAD
    printf '\0diff\0'
    repo_git -C "$repo_root" diff --binary --no-ext-diff HEAD --
    printf '\0untracked\0'
    while IFS= read -r -d '' entry; do
      printf '%s\0' "$entry"
      path="$repo_root/$entry"
      if [[ -L "$path" ]]; then
        printf 'symlink\0%s\0' "$(readlink "$path")"
      elif [[ -f "$path" ]]; then
        printf 'file\0%s\0' "$(sha256_file "$path")"
      else
        printf 'other\0'
      fi
    done < <(repo_git -C "$repo_root" ls-files --others --exclude-standard -z)
  } | sha256_stream
}

require_owned_run() {
  [[ -d "$run_root" ]] || fail "run root missing: $run_root"
  [[ ! -L "$run_root" ]] || fail "run root is a symlink: $run_root"
  [[ "$(uid_of "$run_root")" == "$(id -u)" ]] || fail 'run root has the wrong owner'
  [[ "$(mode_of "$run_root")" == 700 ]] || fail 'run root must be mode 700'
  [[ -f "$owner_file" && ! -L "$owner_file" ]] || fail 'owner marker missing or unsafe'
  [[ "$(uid_of "$owner_file")" == "$(id -u)" ]] || fail 'owner marker has the wrong owner'
  [[ "$(mode_of "$owner_file")" == 600 ]] || fail 'owner marker must be mode 600'
  [[ "$(<"$owner_file")" == "$run_id" ]] || fail 'owner marker does not match run-id'
}

path_is_absent() {
  [[ ! -e "$1" && ! -L "$1" ]]
}

tree_fingerprint() {
  local root=$1 path relative
  [[ -d "$root" && ! -L "$root" ]] || fail "tree fingerprint root is missing or unsafe: $root"
  {
    printf 'root-mode\t%s\n' "$(mode_of "$root")"
    while IFS= read -r path; do
      relative=${path#"$root/"}
      if [[ -L "$path" ]]; then
        printf 'symlink\t%s\t%s\n' "$relative" "$(readlink "$path")"
      elif [[ -f "$path" ]]; then
        printf 'file\t%s\t%s\n' "$relative" "$(sha256_file "$path")"
      elif [[ -d "$path" ]]; then
        printf 'directory\t%s\t%s\n' "$relative" "$(mode_of "$path")"
      else
        printf 'other\t%s\n' "$relative"
      fi
    done < <(find -P "$root" -mindepth 1 -print | LC_ALL=C sort)
  } | sha256_stream
}

sqlite_file_set_fingerprint() {
  local database=$1 candidate
  [[ -f "$database" && ! -L "$database" ]] || fail "SQLite database is missing or unsafe: $database"
  {
    for candidate in "$database" "$database-wal" "$database-shm" "$database-journal"; do
      if path_is_absent "$candidate"; then
        printf 'absent\t%s\n' "${candidate#"$database"}"
      else
        [[ -f "$candidate" && ! -L "$candidate" ]] || fail "SQLite file-set member is unsafe: $candidate"
        printf 'file\t%s\t%s\t%s\n' "${candidate#"$database"}" "$(mode_of "$candidate")" "$(sha256_file "$candidate")"
      fi
    done
  } | sha256_stream
}

backup_git() {
  local repository=$1
  shift
  if [[ -d "$repository/.git" && ! -L "$repository/.git" ]]; then
    task_git -C "$repository" "$@"
  elif [[ -d "$repository" && ! -L "$repository" && -f "$repository/HEAD" ]]; then
    task_git --git-dir="$repository" "$@"
  else
    fail "backup Git repository is missing or unsafe: $repository"
  fi
}

verify_backup_history() {
  local repository=$1 expected_readme_hash=$2 expected_manifest_hash=$3
  local commit path blob_hash commit_count=0 path_count
  while IFS= read -r commit; do
    [[ -n "$commit" ]] || continue
    commit_count=$((commit_count + 1))
    path_count=0
    while IFS= read -r path; do
      [[ -n "$path" ]] || continue
      path_count=$((path_count + 1))
      case "$path" in
        README.md)
          blob_hash=$(backup_git "$repository" show "$commit:$path" | sha256_stream)
          [[ "$blob_hash" == "$expected_readme_hash" ]] || fail "backup history contains an unexpected recovery README at $commit"
          ;;
        manifest.json)
          blob_hash=$(backup_git "$repository" show "$commit:$path" | sha256_stream)
          [[ "$blob_hash" == "$expected_manifest_hash" ]] || fail "backup history contains an unexpected cleartext manifest at $commit"
          ;;
        data/connections.jsonl.gz.age|data/data_points.jsonl.gz.age|data/data_point_revisions.jsonl.gz.age|data/data_point_attachments.jsonl.gz.age|data/attachment_payloads.jsonl.gz.age|data/rollups.jsonl.gz.age|data/identity_snapshots.jsonl.gz.age|data/sync_runs.jsonl.gz.age|data/sync_cursors.jsonl.gz.age)
          backup_git "$repository" show "$commit:$path" | grep -aF 'age-encryption.org/v1' >/dev/null || fail "backup history contains non-age payload data at $commit:$path"
          ;;
        *) fail "backup history contains a non-allowlisted path at $commit:$path" ;;
      esac
    done < <(backup_git "$repository" ls-tree -r --name-only "$commit")
    [[ "$path_count" -gt 0 ]] || fail "backup history contains an empty commit tree: $commit"
  done < <(backup_git "$repository" rev-list --all)
  [[ "$commit_count" -gt 0 ]] || fail "backup repository has no reachable commits: $repository"
}

utc_now() {
  date -u +%Y-%m-%dT%H:%M:%SZ
}

append_event() {
  local event=$1
  local label=$2
  local result=$3
  local exit_code=${4:-null}
  require_evidence_root
  printf '{"timestamp":"%s","event":"%s","label":"%s","result":"%s","exit_code":%s}\n' \
    "$(utc_now)" "$event" "$label" "$result" "$exit_code" >> "$evidence_root/events.jsonl"
}

write_manifest() {
  require_evidence_root
  local lifecycle=$1
  local result=$2
  local commit binary_hash started_at finished_at routes_json separator item
  commit=$(repo_git -C "$repo_root" rev-parse HEAD 2>/dev/null || printf dev)
  binary_hash=null
  if [[ -f "$binary" && ! -L "$binary" ]]; then
    binary_hash="\"$(sha256_file "$binary")\""
  elif [[ -f "$evidence_root/launch.txt" ]]; then
    binary_hash="\"$(sed -n 's/^binary_sha256: //p' "$evidence_root/launch.txt")\""
  fi
  started_at=$(sed -n '1p' "$evidence_root/started-at.txt" 2>/dev/null || utc_now)
  finished_at=null
  if [[ "$lifecycle" == cleaned ]]; then
    finished_at="\"$(utc_now)\""
  fi
  routes_json='['
  separator=''
  if [[ -f "$evidence_root/routes.txt" ]]; then
    while IFS= read -r item; do
      [[ -n "$item" ]] || continue
      routes_json+="$separator\"$item\""
      separator=','
    done < "$evidence_root/routes.txt"
  fi
  routes_json+=']'
  {
    printf '{\n'
    printf '  "evidence_schema": 1,\n'
    printf '  "run_id": "%s",\n' "$run_id"
    printf '  "source_commit": "%s",\n' "$commit"
    printf '  "binary_sha256": %s,\n' "$binary_hash"
    printf '  "platform": "%s",\n' "$(uname -s)"
    printf '  "started_at": "%s",\n' "$started_at"
    printf '  "finished_at": %s,\n' "$finished_at"
    printf '  "lifecycle": "%s",\n' "$lifecycle"
    printf '  "result": "%s",\n' "$result"
    printf '  "routes": %s\n' "$routes_json"
    printf '}\n'
  } > "$evidence_root/manifest.json"
}

record_command() {
  local target=$1
  shift
  : > "$target"
  local arg quoted
  for arg in "$@"; do
    printf -v quoted '%q' "$arg"
    printf '%s ' "$quoted" >> "$target"
  done
  printf '\n' >> "$target"
}

run_pty() {
  local label=$1
  shift
  run_pty_expected "$label" 0 "$@"
}

run_pty_expected() {
  local label=$1
  local expected=$2
  shift 2
  local transcript="$evidence_root/$label.typescript"
  local command_file="$evidence_root/$label.command.txt"
  local exit_file="$evidence_root/$label.exit.txt"
  local rc=0 command_line='' arg quoted
  local -a command_args
  command_args=("$@")

  if [[ "${command_args[0]:-}" == "$binary" ]]; then
    command_args=("${task_env_prefix[@]}" "${command_args[@]}")
  fi

  require_evidence_root
  record_command "$command_file" "${command_args[@]}"

  set +e
  if [[ "$(uname -s)" == Darwin ]]; then
    "${pty_env_prefix[@]}" /usr/bin/script -q "$transcript" "${command_args[@]}"
    rc=$?
  else
    for arg in "${command_args[@]}"; do
      printf -v quoted '%q' "$arg"
      command_line+=" $quoted"
    done
    "${pty_env_prefix[@]}" /usr/bin/script -q -e -c "$command_line" "$transcript"
    rc=$?
  fi
  set -e
  printf '%s\n' "$rc" > "$exit_file"
  append_event cli "$label" "$([[ $rc -eq $expected ]] && printf passed || printf failed)" "$rc"
  [[ $rc -eq $expected ]] || fail "$label exited $rc, expected $expected; see $transcript"
}

run_streams_expected() {
  local label=$1 expected=$2
  shift 2
  local stdout_file="$evidence_root/$label.stdout.txt"
  local stderr_file="$evidence_root/$label.stderr.txt"
  local command_file="$evidence_root/$label.command.txt"
  local exit_file="$evidence_root/$label.exit.txt"
  local rc=0
  local -a command_args
  command_args=("$@")
  if [[ "${command_args[0]:-}" == "$binary" ]]; then
    command_args=("${task_env_prefix[@]}" "${command_args[@]}")
  fi
  require_evidence_root
  record_command "$command_file" "${command_args[@]}"
  set +e
  "${pty_env_prefix[@]}" "${command_args[@]}" > "$stdout_file" 2> "$stderr_file"
  rc=$?
  set -e
  printf '%s\n' "$rc" > "$exit_file"
  append_event cli-streams "$label" "$([[ $rc -eq $expected ]] && printf passed || printf failed)" "$rc"
  [[ $rc -eq $expected ]] || fail "$label exited $rc, expected $expected; see stream evidence"
}

doctor_snapshot() {
  local phase=$1
  [[ "$phase" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || fail 'doctor phase is unsafe'
  require_tools
  require_evidence_root
  require_owned_run
  [[ "$(mode_of "$run_root")" == 700 ]] || fail 'run root must be mode 700'
  [[ -d "$home_path" && ! -L "$home_path" && "$(mode_of "$home_path")" == 700 ]] || fail 'task HOME missing or unsafe'
  [[ -x "$binary" && ! -L "$binary" ]] || fail 'task-owned binary missing or unsafe'
  [[ -f "$oauth_file" && ! -L "$oauth_file" ]] || fail 'synthetic OAuth file missing or unsafe'
  [[ "$(mode_of "$oauth_file")" == 600 ]] || fail 'synthetic OAuth file must be mode 600'
  [[ "$(<"$oauth_file")" == "$synthetic_oauth_json" ]] || fail 'OAuth fixture is not the expected synthetic value'
  [[ -f "$discovery_file" && ! -L "$discovery_file" && "$(mode_of "$discovery_file")" == 600 ]] || fail 'public discovery fixture missing or unsafe'
  [[ "$(sha256_file "$discovery_file")" == "$(sha256_file "$discovery_source")" ]] || fail 'public discovery fixture differs from source snapshot'

  local path parent
  for parent in "$(dirname "$config_path")" "$(dirname "$archive_path")"; do
    if ! path_is_absent "$parent"; then
      [[ -d "$parent" && ! -L "$parent" ]] || fail "unsafe task-owned state directory: $parent"
      [[ "$(uid_of "$parent")" == "$(id -u)" ]] || fail "task-owned state directory has the wrong owner: $parent"
      [[ "$(mode_of "$parent")" == 700 ]] || fail "task-owned state directory must be mode 700: $parent"
    fi
  done
  for path in "$config_path" "$archive_path"; do
    if ! path_is_absent "$path"; then
      [[ -f "$path" && ! -L "$path" ]] || fail "unsafe task-owned path: $path"
      [[ "$(mode_of "$path")" == 600 ]] || fail "task-owned file must be mode 600: $path"
    fi
  done
  if ! path_is_absent "$sidecar_path"; then
    [[ -d "$sidecar_path" && ! -L "$sidecar_path" ]] || fail "unsafe sidecar path: $sidecar_path"
    [[ "$(mode_of "$sidecar_path")" == 700 ]] || fail 'sidecar must be mode 700'
  fi

  local expected_commit expected_binary_hash expected_source_fingerprint
  expected_commit=$(repo_git -C "$repo_root" rev-parse HEAD)
  expected_binary_hash=$(sed -n 's/^binary_sha256: //p' "$evidence_root/launch.txt")
  expected_source_fingerprint=$(sed -n 's/^source_fingerprint: //p' "$evidence_root/launch.txt")
  [[ -n "$expected_binary_hash" && -n "$expected_source_fingerprint" ]] || fail 'launch identity evidence is incomplete'
  [[ "$(sha256_file "$binary")" == "$expected_binary_hash" ]] || fail 'task-owned binary changed after launch'
  [[ "$(repo_content_fingerprint)" == "$expected_source_fingerprint" ]] || fail 'repository contents changed after launch'
  path_is_absent "$evidence_root/doctor-$phase.txt" || fail "doctor snapshot already exists for phase: $phase"
  run_pty "doctor-$phase-version" "$binary" --json --version
  grep -Fq "\"commit\":\"$expected_commit\"" "$evidence_root/doctor-$phase-version.typescript" || fail 'binary commit does not match checkout'
  printf 'doctor: passed\nphase: %s\nrun_id: %s\nowner_marker: exact\nrun_root_mode: %s\ntask_home_mode: %s\nsynthetic_oauth_mode: %s\nbinary_sha256: %s\nbinary_commit: %s\nsource_fingerprint: %s\nconfig_state: %s\narchive_state: %s\nsidecar_state: %s\n' \
    "$phase" "$run_id" "$(mode_of "$run_root")" "$(mode_of "$home_path")" "$(mode_of "$oauth_file")" "$expected_binary_hash" "$expected_commit" "$expected_source_fingerprint" \
    "$(! path_is_absent "$config_path" && printf present || printf absent)" \
    "$(! path_is_absent "$archive_path" && printf present || printf absent)" \
    "$(! path_is_absent "$sidecar_path" && printf present || printf absent)" \
    > "$evidence_root/doctor-$phase.txt"
  append_event doctor "$phase" passed 0
  printf 'doctor passed: %s (%s)\n' "$run_id" "$phase"
}

launch() {
  require_tools
  require_evidence_parent
  path_is_absent "$run_root" || fail "refusing existing run root: $run_root"
  path_is_absent "$evidence_root" || fail "refusing existing evidence root: $evidence_root"
  mkdir -m 700 "$run_root"
  [[ -d "$run_root" && ! -L "$run_root" && "$(uid_of "$run_root")" == "$(id -u)" ]] || fail 'new run root is unsafe'
  mkdir "$run_root/bin" "$home_path" "$shim_path"
  mkdir -m 700 "$evidence_root"
  chmod 700 "$run_root" "$run_root/bin" "$home_path" "$shim_path"
  printf '%s\n' "$run_id" > "$owner_file"
  chmod 600 "$owner_file"
  printf '%s\n' "$synthetic_oauth_json" > "$oauth_file"
  chmod 600 "$oauth_file"
  cp "$discovery_source" "$discovery_file"
  chmod 600 "$discovery_file"
  cp "$repo_root/README.md" "$readme_file"
  chmod 600 "$readme_file"
  printf '[user]\n\tname = gohealthcli verification\n\temail = verification@example.invalid\n' > "$gitconfig_file"
  chmod 600 "$gitconfig_file"
  printf '#!/usr/bin/env bash\nprintf "credential store access attempted\\n" > %q\nexit 97\n' "$credential_probe" > "$shim_path/security"
  chmod 700 "$shim_path/security"
  cp "$shim_path/security" "$shim_path/secret-tool"
  chmod 700 "$shim_path/secret-tool"
  utc_now > "$evidence_root/started-at.txt"
  repo_git -C "$repo_root" status --porcelain=v1 > "$evidence_root/git-status-before.txt"
  append_event lifecycle launch started null

  local version commit built ldflags source_fingerprint
  source_fingerprint=$(repo_content_fingerprint)
  printf '%s\n' "$source_fingerprint" > "$evidence_root/repo-fingerprint-before.txt"
  stage_source_snapshot
  version=$(repo_git -C "$repo_root" describe --tags --always --dirty 2>/dev/null || printf dev)
  commit=$(repo_git -C "$repo_root" rev-parse HEAD 2>/dev/null || printf dev)
  built=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  ldflags="-X main.version=$version -X main.commit=$commit -X main.built=$built"
  record_command "$evidence_root/build.command.txt" go build -ldflags "$ldflags" -o "$binary" ./cmd/gohealthcli
  isolated_go_build "$run_root/go-build-state" "$binary" "$ldflags" ./cmd/gohealthcli "$source_snapshot"
  printf '0\n' > "$evidence_root/build.exit.txt"
  printf 'commit: %s\nbinary: %s\nbinary_sha256: %s\nsource_fingerprint: %s\n' "$commit" "$binary" "$(sha256_file "$binary")" "$source_fingerprint" > "$evidence_root/launch.txt"
  run_pty launch-version "$binary" --json --version
  grep -Fq "\"commit\":\"$commit\"" "$evidence_root/launch-version.typescript" || fail 'readiness version output missing expected commit'
  doctor_snapshot launch
  write_manifest launched passed
}

drive_initialize() {
  path_is_absent "$config_path" && path_is_absent "$archive_path" && path_is_absent "$sidecar_path" || fail 'initialize route requires fresh state'
  local expected_migration expected_version expected_name
  expected_migration=$(sed -n 's/.*{version: \([0-9][0-9]*\), name: "\([^"]*\)".*/\1|\2/p' "$repo_root/cmd/gohealthcli/health_archive_migrations.go" | tail -n 1)
  [[ "$expected_migration" == *'|'* ]] || fail 'could not determine the current latest migration'
  expected_version=${expected_migration%%|*}
  expected_name=${expected_migration#*|}
  run_pty initialize "$binary" --config "$config_path" --db "$archive_path" --json --no-input init --oauth-client-file "$oauth_file"
  grep -Fq '"status": "initialized"' "$evidence_root/initialize.typescript" || fail 'init result missing initialized status'
  grep -Fq "\"schema_version\": $expected_version" "$evidence_root/initialize.typescript" || fail 'init did not report the repository latest migration version'
  [[ -f "$config_path" && ! -L "$config_path" ]] || fail 'config was not created safely'
  [[ -f "$archive_path" && ! -L "$archive_path" ]] || fail 'archive was not created safely'
  [[ -d "$sidecar_path" && ! -L "$sidecar_path" ]] || fail 'sidecar was not created safely'
  [[ "$(mode_of "$config_path")" == 600 ]] || fail 'config must be mode 600'
  [[ "$(mode_of "$archive_path")" == 600 ]] || fail 'archive must be mode 600'
  [[ "$(mode_of "$sidecar_path")" == 700 ]] || fail 'sidecar must be mode 700'

  run_pty initialize-confirm "$binary" --db "$archive_path" --json query 'SELECT version, name FROM schema_migrations ORDER BY version DESC LIMIT 1'
  grep -Fq '"status": "query_completed"' "$evidence_root/initialize-confirm.typescript" || fail 'second read did not complete'
  grep -Fq '"row_count": 1' "$evidence_root/initialize-confirm.typescript" || fail 'second read did not find latest migration'
  grep -Eq "^[[:space:]]+$expected_version," "$evidence_root/initialize-confirm.typescript" || fail 'second read did not return the repository latest migration version'
  grep -Fq "\"$expected_name\"" "$evidence_root/initialize-confirm.typescript" || fail 'second read did not return the repository latest migration name'

  run_pty initialize-existing "$binary" --config "$config_path" --db "$archive_path" --json --no-input init --oauth-client-file "$oauth_file"
  grep -Fq '"status": "already_initialized"' "$evidence_root/initialize-existing.typescript" || fail 'existing setup did not report already_initialized'
  printf 'route: initialize\nresult: passed\nsecond_read: initialize-confirm.typescript\nexisting_setup: already_initialized\nconfig_mode: %s\narchive_mode: %s\noauth_reference_mode: %s\nsidecar_mode: %s\n' \
    "$(mode_of "$config_path")" "$(mode_of "$archive_path")" "$(mode_of "$oauth_file")" "$(mode_of "$sidecar_path")" > "$evidence_root/initialize-proof.txt"
}

drive_inspect() {
  [[ -f "$archive_path" && ! -L "$archive_path" ]] || fail 'inspect route requires an initialized archive'
  local archive_files_before
  run_pty inspect-status "$binary" --db "$archive_path" --json status
  grep -Fq '"schema_version":' "$evidence_root/inspect-status.typescript" || fail 'status missing schema version'
  grep -Fq '"data_point_count": 0' "$evidence_root/inspect-status.typescript" || fail 'empty archive status changed unexpectedly'

  run_pty inspect-status-plain "$binary" --db "$archive_path" --plain status
  grep -Fq 'data_point_count: 0' "$evidence_root/inspect-status-plain.typescript" || fail 'plain status missing empty Data Point count'

  run_pty inspect-query "$binary" --db "$archive_path" --json query 'SELECT version, name FROM schema_migrations ORDER BY version DESC LIMIT 1'
  grep -Fq '"status": "query_completed"' "$evidence_root/inspect-query.typescript" || fail 'query did not complete'

  archive_files_before=$(sqlite_file_set_fingerprint "$archive_path")
  run_pty_expected inspect-query-rejected 1 "$binary" --db "$archive_path" --json query 'DELETE FROM data_points'
  grep -Fq 'query accepts SELECT statements only' "$evidence_root/inspect-query-rejected.typescript" || fail 'write query did not hit the SELECT-only guard'
  [[ "$(sqlite_file_set_fingerprint "$archive_path")" == "$archive_files_before" ]] || fail 'rejected query changed the SQLite file set'

  run_pty inspect-schema "$binary" --db "$archive_path" --json describe-schema
  grep -Fq '"version": 1' "$evidence_root/inspect-schema.typescript" || fail 'schema description missing contract version'
  grep -Fq '"tables"' "$evidence_root/inspect-schema.typescript" || fail 'schema description missing tables'

  run_pty inspect-schema-sql "$binary" --db "$archive_path" --json describe-schema --sql
  grep -Fq 'CREATE TABLE' "$evidence_root/inspect-schema-sql.typescript" || fail 'schema SQL missing table DDL'

  local export_path="$run_root/data/daily-steps.csv"
  local jsonl_path="$run_root/data/daily-steps.jsonl"
  local expected_header='provider_name,connection_id,civil_date,step_count,source_kind,source_family_filter,source_record_count,latest_source_timestamp'
  local actual_header
  run_pty inspect-export "$binary" --db "$archive_path" export daily-steps --format csv --output "$export_path"
  [[ -f "$export_path" && ! -L "$export_path" ]] || fail 'export output was not created safely'
  IFS= read -r actual_header < "$export_path"
  [[ "$actual_header" == "$expected_header" ]] || fail 'empty daily-steps export header drifted'
  cp "$export_path" "$evidence_root/inspect-export.csv"
  run_pty inspect-export-jsonl "$binary" --db "$archive_path" export daily-steps --format jsonl --output "$jsonl_path"
  [[ -f "$jsonl_path" && ! -L "$jsonl_path" && ! -s "$jsonl_path" ]] || fail 'empty JSONL export was not an empty regular file'
  cp "$jsonl_path" "$evidence_root/inspect-export.jsonl"
  printf 'route: inspect\nresult: passed\nentries: status-json,status-plain,query,query-write-rejection,describe-schema,describe-schema-sql,export-csv,export-jsonl\narchive_after_rejected_write: unchanged\ncsv_sha256: %s\njsonl_sha256: %s\n' \
    "$(sha256_file "$export_path")" "$(sha256_file "$jsonl_path")" > "$evidence_root/inspect-proof.txt"
}

assert_raw_plan_no_effects() {
  local transcript=$1 effect
  for effect in provider_request credential_store_read token_load token_refresh health_archive_open health_archive_write rollup_write sync_run_change migration cursor_change sidecar_creation; do
    grep -Fq "\"$effect\": false" "$transcript" || fail "raw planning effect $effect was not false in $(basename "$transcript")"
  done
}

drive_plan() {
  path_is_absent "$config_path" && path_is_absent "$archive_path" && path_is_absent "$sidecar_path" || fail 'plan route requires fresh state'
  path_is_absent "$default_config_path" && path_is_absent "$default_archive_path" && path_is_absent "$default_sidecar_path" || fail 'plan route requires absent isolated default state'
  run_pty plan-identity "$binary" raw endpoint getIdentity --plan --json
