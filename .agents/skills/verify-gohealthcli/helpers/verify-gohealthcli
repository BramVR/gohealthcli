  grep -Fq '"endpoint_name": "getIdentity"' "$evidence_root/plan-identity.typescript" || fail 'raw plan target drifted from getIdentity'
  grep -Fq '"method": "GET"' "$evidence_root/plan-identity.typescript" || fail 'raw plan method drifted from GET'
  grep -Fq '"url": "https://health.googleapis.com/v4/users/me/identity"' "$evidence_root/plan-identity.typescript" || fail 'raw plan URL drifted from the sanitized identity endpoint'
  local sensitive
  for sensitive in access_token client_secret Authorization pageToken; do
    if grep -Fq "$sensitive" "$evidence_root/plan-identity.typescript"; then
      fail "raw plan leaked sensitive request material: $sensitive"
    fi
  done
  assert_raw_plan_no_effects "$evidence_root/plan-identity.typescript"

  run_pty plan-data-type "$binary" raw data-type steps --from 2026-01-01T00:00:00Z --to 2026-01-02T00:00:00Z --timezone Europe/Brussels --plan --json
  grep -Fq '"data_type": "steps"' "$evidence_root/plan-data-type.typescript" || fail 'Data Type plan missing steps target'
  grep -Fq '"from": "2026-01-01T00:00:00Z"' "$evidence_root/plan-data-type.typescript" || fail 'Data Type plan missing fixed from bound'
  grep -Fq '"to": "2026-01-02T00:00:00Z"' "$evidence_root/plan-data-type.typescript" || fail 'Data Type plan missing fixed to bound'
  grep -Fq '"timezone": "Europe/Brussels"' "$evidence_root/plan-data-type.typescript" || fail 'Data Type plan did not preserve the requested timezone'
